<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Window-level theme only. All UI is drawn by Jetpack Compose (see ui/theme/Theme.kt), so this
        theme just paints the dark canvas behind the first frame and keeps the system bars transparent
        for edge-to-edge rendering. AppCompat is the parent because per-app language switching on
        Android 12 and lower relies on AppCompatDelegate.
    -->
    <style name="Theme.StreamPlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorPrimary">@color/lilac</item>
        <item name="colorAccent">@color/lilac</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
