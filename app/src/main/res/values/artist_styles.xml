<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.LocalPure.Banner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Header statistics (pen: value 20sp bold, label 12sp muted). -->
    <style name="TextAppearance.LocalPure.Stat.Value" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.LocalPure.Title.Medium</item>
    </style>

    <style name="TextAppearance.LocalPure.Stat.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.LocalPure.Body.Small</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
