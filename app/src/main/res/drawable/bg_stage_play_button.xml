<?xml version="1.0" encoding="utf-8"?>
<!-- 56dp accent play/pause disc inside a 64dp touch target. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/lp_accent" />
        </shape>
    </item>
</ripple>
