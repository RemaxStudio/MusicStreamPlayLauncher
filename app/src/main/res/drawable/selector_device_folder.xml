<?xml version="1.0" encoding="utf-8"?>
<!-- Selected folder: accent pill; others: translucent pill. Inset keeps a 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="6dp"
    android:insetBottom="6dp">
    <ripple android:color="@color/lp_overlay_pressed">
        <item>
            <selector>
                <item android:state_selected="true">
                    <shape android:shape="rectangle">
                        <corners android:radius="18dp" />
                        <solid android:color="@color/lp_accent" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="18dp" />
                        <solid android:color="@color/lp_overlay_fill" />
                    </shape>
                </item>
            </selector>
        </item>
    </ripple>
</inset>
