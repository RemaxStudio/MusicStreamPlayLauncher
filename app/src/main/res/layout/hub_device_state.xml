<?xml version="1.0" encoding="utf-8"?>
<!-- Local home status (permission / empty / error / loading), pen C6L63e anatomy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:minHeight="160dp"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/illustration"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:layout_marginBottom="20dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:visibility="gone"
        tools:src="@drawable/img_lp_music_folder"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LocalPure.Title.Large"
        tools:text="Access your music" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:maxLines="3"
        android:paddingHorizontal="12dp"
        android:textAppearance="@style/TextAppearance.LocalPure.Body.Medium"
        tools:text="Allow LocalPure to find and play audio files stored on this device." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="@style/Widget.LocalPure.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minWidth="204dp"
        android:visibility="gone"
        tools:text="Allow access"
        tools:visibility="visible" />
</LinearLayout>
