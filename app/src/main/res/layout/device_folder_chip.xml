<?xml version="1.0" encoding="utf-8"?>
<!-- Folder filter chip (pen WHxL7): 36dp pill inside a 48dp touch row. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/selector_device_folder"
    android:clickable="true"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center"
    android:maxWidth="220dp"
    android:maxLines="1"
    android:minWidth="104dp"
    android:paddingHorizontal="16dp"
    android:textAppearance="@style/TextAppearance.LocalPure.Label.Medium"
    android:textColor="@color/selector_device_folder_text"
    tools:text="All music · 6" />
