<?xml version="1.0" encoding="utf-8"?>
<!-- "Add to playlist" sheet (pen aVxoF / Cmf8l): header with New, playlist rows or empty state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_action_sheet"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <include layout="@layout/sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/playlist_add_title"
            android:textAppearance="@style/TextAppearance.LocalPure.Title.Large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createPlaylist"
            style="@style/Widget.LocalPure.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="78dp"
            android:minHeight="48dp"
            android:insetTop="6dp"
            android:insetBottom="6dp"
            android:paddingHorizontal="18dp"
            android:text="@string/playlist_new" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="18dp"
            android:visibility="gone"
            tools:listitem="@layout/playlist_picker_row"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minHeight="260dp"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="40dp">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_collection_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/playlist_empty_title"
                android:textAppearance="@style/TextAppearance.LocalPure.Title.Dialog"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/playlist_empty_message"
                android:textAppearance="@style/TextAppearance.LocalPure.Body.Medium" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
