<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="13dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/home_brand"
        android:textAppearance="@style/TextAppearance.LocalPure.Wordmark" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search"
        style="@style/Widget.LocalPure.IconButton.Circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/home_search"
        android:tooltipText="@string/home_search"
        app:icon="@drawable/ic_lp_search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings"
        style="@style/Widget.LocalPure.IconButton.Circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="7dp"
        android:contentDescription="@string/home_settings"
        android:tooltipText="@string/home_settings"
        app:icon="@drawable/ic_hub_settings" />
</LinearLayout>
