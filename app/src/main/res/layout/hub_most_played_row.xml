<?xml version="1.0" encoding="utf-8"?>
<!-- Compact "Most played" row: 52dp cover, title/artist, play affordance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal">

    <com.amberwave.player.feature.hub.HubArtworkView
        android:id="@+id/cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_lp_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/Widget.LocalPure.TrackTitle"
            android:textColor="@color/selector_track_title"
            android:textSize="14.5sp"
            tools:text="Enchanted" />

        <TextView
            android:id="@+id/artist"
            style="@style/Widget.LocalPure.TrackArtist"
            android:textColor="@color/selector_track_artist"
            android:textSize="12.5sp"
            tools:text="Taylor Swift" />
    </LinearLayout>

    <ImageView
        android:id="@+id/play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ic_lp_play_circle_small" />
</LinearLayout>
