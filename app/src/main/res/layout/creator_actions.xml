<?xml version="1.0" encoding="utf-8"?>
<!-- Artist primary actions (pen AK6bw): Play popular pill + circular share. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="4dp"
    android:paddingEnd="13dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/play"
        style="@style/Widget.LocalPure.Button.Play"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/artist_play_popular" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/share"
        style="@style/Widget.LocalPure.IconButton.Circle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="7dp"
        android:contentDescription="@string/artist_share"
        android:tooltipText="@string/artist_share"
        app:icon="@drawable/ic_transport_share" />
</LinearLayout>
