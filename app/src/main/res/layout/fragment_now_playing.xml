<?xml version="1.0" encoding="utf-8"?>
<!--
    Full player (pen FpHZ1): toolbar, record / text stage with flip hint, track info,
    "Add to playlist", seek row and transport controls. The stage takes the remaining height,
    so short screens shrink the record instead of overlapping the controls.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lp_atmosphere">

    <ImageButton
        android:id="@+id/back"
        style="@style/Widget.LocalPure.ImageButton"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/player_toolbar_margin_top"
        android:contentDescription="@string/player_close"
        android:src="@drawable/ic_lp_expand_more"
        android:tooltipText="@string/player_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nowPlayingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="112dp"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/home_playing"
        android:textAppearance="@style/TextAppearance.LocalPure.Title.Medium"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="@id/back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/back" />

    <!-- Active sleep timer: "Sleep in 14:32" / "Sleep after this song". -->
    <TextView
        android:id="@+id/sleepTimerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.LocalPure.Caption"
        android:textColor="@color/lp_accent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nowPlayingTitle"
        tools:text="Sleep in 14:32"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/sleepTimer"
        style="@style/Widget.LocalPure.ImageButton"
        android:layout_marginTop="@dimen/player_toolbar_margin_top"
        android:contentDescription="@string/sleep_timer_title"
        android:src="@drawable/ic_lp_sleep_timer"
        android:tooltipText="@string/sleep_timer_title"
        app:layout_constraintEnd_toStartOf="@id/share"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headerBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="back,sleepTimerStatus" />

    <ImageButton
        android:id="@+id/share"
        style="@style/Widget.LocalPure.ImageButton"
        android:layout_marginTop="@dimen/player_toolbar_margin_top"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/player_share"
        android:src="@drawable/ic_transport_share"
        android:tooltipText="@string/player_share"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.amberwave.player.feature.nowplaying.PlayerStageView
        android:id="@+id/artwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/player_artwork_margin_top"
        app:layout_constraintBottom_toTopOf="@id/flipHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBottom" />

    <!-- "Show lyrics ›" / "Show album artwork ›": flips the stage. -->
    <TextView
        android:id="@+id/flipHint"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="@dimen/player_title_margin_top"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:textAppearance="@style/TextAppearance.LocalPure.Caption"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Show lyrics  ›"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.LocalPure.Title.Large"
        app:layout_constraintBottom_toTopOf="@id/artist"
        app:layout_constraintEnd_toStartOf="@id/favorite"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Fred From Jupiter" />

    <TextView
        android:id="@+id/artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:maxLines="1"
        android:minHeight="28dp"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="8dp"
        android:textAppearance="@style/TextAppearance.LocalPure.Body.Medium"
        app:layout_constraintBottom_toTopOf="@id/addToPlaylist"
        app:layout_constraintEnd_toStartOf="@id/favorite"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Digette" />

    <ImageButton
        android:id="@+id/favorite"
        style="@style/Widget.LocalPure.ImageButton"
        android:layout_marginEnd="18dp"
        android:contentDescription="@string/player_favorite"
        android:src="@drawable/ic_transport_favorite"
        android:tooltipText="@string/player_favorite"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addToPlaylist"
        style="@style/Widget.LocalPure.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/player_add_playlist"
        app:icon="@drawable/ic_transport_add"
        app:iconPadding="16dp"
        app:iconSize="24dp"
        app:iconTint="@color/lp_icon"
        app:layout_constraintBottom_toTopOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 时间与进度条共享上下约束，在字体缩放下仍保持同一条视觉中轴。 -->
    <TextView
        android:id="@+id/currentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:minWidth="44dp"
        android:text="@string/player_time_zero"
        android:textAppearance="@style/TextAppearance.LocalPure.Numeric"
        android:textColor="@color/lp_on_surface"
        app:layout_constraintBottom_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/seekBar" />

    <com.amberwave.player.feature.nowplaying.PlaybackSeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="@dimen/player_seek_control_gap"
        android:contentDescription="@string/player_seek"
        app:layout_constraintBottom_toTopOf="@id/play"
        app:layout_constraintEnd_toStartOf="@id/duration"
        app:layout_constraintStart_toEndOf="@id/currentTime" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="end"
        android:minWidth="44dp"
        android:text="@string/player_time_zero"
        android:textAppearance="@style/TextAppearance.LocalPure.Numeric"
        android:textColor="@color/lp_on_surface"
        app:layout_constraintBottom_toBottomOf="@id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/seekBar" />

    <ImageButton
        android:id="@+id/shuffle"
        style="@style/Widget.LocalPure.ImageButton"
        android:contentDescription="@string/player_sequential"
        android:src="@drawable/ic_transport_sequential"
        app:layout_constraintBottom_toBottomOf="@id/play"
        app:layout_constraintEnd_toStartOf="@id/previous"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/play"
        android:layout_marginStart="18dp" />

    <ImageButton
        android:id="@+id/previous"
        style="@style/Widget.LocalPure.ImageButton"
        android:contentDescription="@string/player_previous"
        android:src="@drawable/ic_transport_previous"
        android:tooltipText="@string/player_previous"
        app:layout_constraintBottom_toBottomOf="@id/play"
        app:layout_constraintEnd_toStartOf="@id/play"
        app:layout_constraintStart_toEndOf="@id/shuffle"
        app:layout_constraintTop_toTopOf="@id/play" />

    <ImageButton
        android:id="@+id/play"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="@dimen/player_control_bottom_margin"
        android:background="@drawable/bg_stage_play_button"
        android:contentDescription="@string/home_play"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_transport_play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/next"
        app:layout_constraintStart_toEndOf="@id/previous"
        app:tint="@color/lp_on_accent" />

    <ImageButton
        android:id="@+id/next"
        style="@style/Widget.LocalPure.ImageButton"
        android:contentDescription="@string/player_next"
        android:src="@drawable/ic_transport_next"
        android:tooltipText="@string/player_next"
        app:layout_constraintBottom_toBottomOf="@id/play"
        app:layout_constraintEnd_toStartOf="@id/queue"
        app:layout_constraintStart_toEndOf="@id/play"
        app:layout_constraintTop_toTopOf="@id/play" />

    <ImageButton
        android:id="@+id/queue"
        style="@style/Widget.LocalPure.ImageButton"
        android:layout_marginEnd="18dp"
        android:contentDescription="@string/player_queue"
        android:src="@drawable/ic_transport_queue"
        android:tooltipText="@string/player_queue"
        app:layout_constraintBottom_toBottomOf="@id/play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/next"
        app:layout_constraintTop_toTopOf="@id/play" />
</androidx.constraintlayout.widget.ConstraintLayout>
