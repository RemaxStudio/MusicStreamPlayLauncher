<?xml version="1.0" encoding="utf-8"?>
<!-- Recommended Musics (pen jslSZ / l4nZh): toolbar, track list, pinned Play all + mini player. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recommendedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lp_atmosphere"
    tools:context=".recommended.RecommendedMusicActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:navigationContentDescription="@string/player_close"
            app:navigationIcon="@drawable/ic_lp_arrow_back"
            app:title="@string/recommended_title">

            <ImageButton
                android:id="@+id/multipleChoice"
                style="@style/Widget.LocalPure.ImageButton"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/recommended_multiple_choice"
                android:src="@drawable/ic_lp_checklist"
                android:tooltipText="@string/recommended_multiple_choice" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/musicList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/discover_track_row" />

    <include
        android:id="@+id/state"
        layout="@layout/status_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Bottom controls stay pinned; BottomAdSlot lifts the whole bar above an ad. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playAll"
            style="@style/Widget.LocalPure.Button.Play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:text="@string/recommended_play_all" />

        <FrameLayout
            android:id="@+id/miniPlayerHost"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <include
                android:id="@+id/miniPlayer"
                layout="@layout/now_playing_bar"
                android:layout_width="match_parent"
                android:layout_height="72dp" />
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
