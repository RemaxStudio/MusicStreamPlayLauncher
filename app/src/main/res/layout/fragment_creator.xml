<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/artistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lp_atmosphere"
    tools:context=".artist.ArtistActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            app:contentScrim="@color/lp_background"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="200"
            app:statusBarScrim="@color/lp_background"
            app:titleEnabled="false">

            <!-- Header (pen AK6bw): rounded banner, ringed avatar overlapping it, name and stats. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/artist_toolbar_height"
                android:paddingBottom="12dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/heroCover"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/lp_cover_placeholder"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_creator_hero"
                    app:layout_constraintDimensionRatio="H,354:162"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.LocalPure.Banner" />

                <View
                    android:id="@+id/heroScrim"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_creator_scrim"
                    app:layout_constraintBottom_toBottomOf="@id/heroCover"
                    app:layout_constraintEnd_toEndOf="@id/heroCover"
                    app:layout_constraintStart_toStartOf="@id/heroCover" />

                <Space
                    android:id="@+id/avatarAnchor"
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    app:layout_constraintBottom_toBottomOf="@id/heroCover"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="30dp"
                    android:background="@color/lp_cover_placeholder"
                    android:contentDescription="@string/artist_avatar"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_creator_placeholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/avatarAnchor"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.LocalPure.Full"
                    app:strokeColor="@color/lp_background"
                    app:strokeWidth="4dp" />

                <TextView
                    android:id="@+id/artistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="18dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.LocalPure.Display"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/avatar"
                    app:layout_constraintTop_toBottomOf="@id/heroCover"
                    tools:text="Digette" />

                <LinearLayout
                    android:id="@+id/artistMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/avatar"
                    app:layout_constraintTop_toBottomOf="@id/artistName">

                    <ImageView
                        android:id="@+id/verified"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@string/artist_verified"
                        android:src="@drawable/ic_creator_verified"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/handle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.LocalPure.Body.Small"
                        tools:text="@string/artist_title" />

                    <TextView
                        android:id="@+id/metaSeparator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="7dp"
                        android:text="@string/artist_meta_separator"
                        android:textAppearance="@style/TextAppearance.LocalPure.Body.Small" />

                    <TextView
                        android:id="@+id/location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.LocalPure.Body.Small" />
                </LinearLayout>

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/identityBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="avatar,artistMeta" />

                <LinearLayout
                    android:id="@+id/stats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/identityBottom">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/followersValue"
                            style="@style/TextAppearance.LocalPure.Stat.Value"
                            tools:text="128" />

                        <TextView
                            style="@style/TextAppearance.LocalPure.Stat.Label"
                            android:text="@string/artist_followers" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tracksValue"
                            style="@style/TextAppearance.LocalPure.Stat.Value"
                            tools:text="3" />

                        <TextView
                            style="@style/TextAppearance.LocalPure.Stat.Label"
                            android:text="@string/artist_tracks" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/albumsValue"
                            style="@style/TextAppearance.LocalPure.Stat.Value"
                            tools:text="2" />

                        <TextView
                            style="@style/TextAppearance.LocalPure.Stat.Label"
                            android:text="@string/artist_releases" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/artist_toolbar_height"
                android:layout_gravity="top"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="@string/action_back"
                app:navigationIcon="@drawable/ic_lp_arrow_back"
                app:title="@string/artist_title" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:paddingBottom="18dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/discover_track_row" />

    <include
        android:id="@+id/state"
        layout="@layout/status_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/miniPlayerHost"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior">

        <include
            android:id="@+id/miniPlayer"
            layout="@layout/now_playing_bar"
            android:layout_width="match_parent"
            android:layout_height="72dp" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
