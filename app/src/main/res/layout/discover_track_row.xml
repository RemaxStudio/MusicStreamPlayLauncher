<?xml version="1.0" encoding="utf-8"?>
<!-- Recommended / search track row: 64dp, 48dp cover, overflow or selection checkbox. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_query_result_ripple"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:paddingStart="18dp"
    android:paddingEnd="6dp">

    <com.amberwave.player.core.ui.CoverArtView
        android:id="@+id/cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_lp_cover"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/textGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/trailingAction"
        app:layout_constraintStart_toEndOf="@id/cover"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title"
            style="@style/Widget.LocalPure.TrackTitle"
            android:textColor="@color/selector_track_title"
            tools:text="Music name" />

        <TextView
            android:id="@+id/artist"
            style="@style/Widget.LocalPure.TrackArtist"
            android:textColor="@color/selector_track_artist"
            tools:text="Singer Name" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/trailingAction"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/more"
            style="@style/Widget.LocalPure.ImageButton"
            android:contentDescription="@string/home_more"
            android:src="@drawable/ic_lp_more_horiz" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/selected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:button="@null"
            android:clickable="true"
            android:contentDescription="@string/recommended_select_track"
            android:foreground="@drawable/selector_select_checkbox"
            android:foregroundGravity="center"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
