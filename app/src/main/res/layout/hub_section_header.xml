<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/title"
        style="@style/Widget.LocalPure.SectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="@string/home_section_recommended" />

    <!-- "More ›" accent link (Recommended). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        style="@style/Widget.LocalPure.Button.Link"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:visibility="gone"
        tools:text="@string/home_section_more"
        tools:visibility="visible" />

    <!-- "Play all" outlined pill (Recently played / Local music). -->
    <TextView
        android:id="@+id/pillAction"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_lp_pill_outline"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingHorizontal="12dp"
        android:textAppearance="@style/TextAppearance.LocalPure.Caption"
        android:visibility="gone"
        tools:text="@string/home_play_all" />
</LinearLayout>
